# Dataset-generation source code, notebooks, tests, and Markdown under
# datagen/ are versioned. Only the machine-local storage link is ignored;
# it points to the large raw/processed datasets under /data/wanglz/.
/datagen/data
/datagen/**/outputs/
/datagen/**/.ipynb_checkpoints/

# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated figures and trained-model directories
/figures/generated/
