
# This paper post-processing branch intentionally publishes only the two
# project trees below (plus this repository-control file).
/*
!/.gitignore
!/0_demo_TurbulentCombustion/
!/1_SubTask_SuperResolution/
!/Dis_SI_Process/

/0_demo_TurbulentCombustion/**
/1_SubTask_SuperResolution/**
/Dis_SI_Process/**

# Keep directory traversal available, then allow only source, documentation,
# and reproducibility configuration files. Generated data, checkpoints,
# caches, logs, and rendered figures remain local.
!/0_demo_TurbulentCombustion/**/
!/1_SubTask_SuperResolution/**/
!/Dis_SI_Process/**/

!/0_demo_TurbulentCombustion/**/*.py
!/1_SubTask_SuperResolution/**/*.py
!/Dis_SI_Process/**/*.py
!/0_demo_TurbulentCombustion/**/*.sh
!/1_SubTask_SuperResolution/**/*.sh
!/0_demo_TurbulentCombustion/**/*.yaml
!/1_SubTask_SuperResolution/**/*.yaml
!/Dis_SI_Process/**/*.yaml
!/0_demo_TurbulentCombustion/**/*.yml
!/1_SubTask_SuperResolution/**/*.yml
!/Dis_SI_Process/**/*.yml
!/0_demo_TurbulentCombustion/**/*.toml
!/1_SubTask_SuperResolution/**/*.toml
!/0_demo_TurbulentCombustion/**/*.md
!/1_SubTask_SuperResolution/**/*.md
!/Dis_SI_Process/**/*.md
!/Dis_SI_Process/.gitignore

# Figure 5 workflow: keep code/config/contracts/docs, not generated products.
/Dis_SI_Process/results/**
/Dis_SI_Process/figures/generated/**
!/Dis_SI_Process/results/.gitkeep
!/Dis_SI_Process/figures/generated/.gitkeep
!/0_demo_TurbulentCombustion/**/*.ipynb
!/1_SubTask_SuperResolution/**/*.ipynb
!/0_demo_TurbulentCombustion/.gitignore
!/1_SubTask_SuperResolution/.gitignore

# Preserve dependency lists and placeholder README files without extensions.
!/0_demo_TurbulentCombustion/**/requirements.txt
!/1_SubTask_SuperResolution/**/requirements.txt
!/0_demo_TurbulentCombustion/**/README
!/1_SubTask_SuperResolution/**/README

# JSON is generally generated output. Retain only key reproducibility configs.
!/0_demo_TurbulentCombustion/**/args.json
!/1_SubTask_SuperResolution/**/args.json
!/0_demo_TurbulentCombustion/**/*config*.json
!/1_SubTask_SuperResolution/**/*config*.json

# Trained-run directories are generated by default. For paper reproduction,
# retain only current visualization/post-processing sources and key configs
# under the curated _TrainedModels trees.
/0_demo_TurbulentCombustion/Save_TrainedModel/**
/1_SubTask_SuperResolution/Save_TrainedModel/**
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.py
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.py
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.sh
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.sh
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.yaml
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.yaml
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.yml
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.yml
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.toml
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.toml
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.md
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.md
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*.ipynb
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*.ipynb
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/args.json
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/args.json
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/*config*.json
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/*config*.json

# Historical snapshots are retained locally, not in the paper branch.
/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/_Backup/**
/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/_Backup/**
/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/**/bk/**
/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/**/bk/**

# Never publish saved outputs, validation products, or rendered/generated
# figure artifacts on this branch, even when they use text-based extensions.
/0_demo_TurbulentCombustion/_CheckNotes/
/1_SubTask_SuperResolution/_CheckNotes/
/0_demo_TurbulentCombustion/Save_loss_csv/
/1_SubTask_SuperResolution/Save_loss_csv/
/0_demo_TurbulentCombustion/Save_reconstruction_files/
/1_SubTask_SuperResolution/Save_reconstruction_files/
/0_demo_TurbulentCombustion/figures/generated/
/1_SubTask_SuperResolution/figures/generated/
/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/figures/generated/
/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/figures/generated/

# _Process_Figures is output by default. Keep only human-authored paper guides.
/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/_Process_Figures/**
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/_Process_Figures/
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/_Process_Figures/_ReviseGuides/
!/0_demo_TurbulentCombustion/Save_TrainedModel/_TrainedModels/_Process_Figures/_ReviseGuides/**/*.md
/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/_Process_Figures/**
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/_Process_Figures/
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/_Process_Figures/_Update_Guides/
!/1_SubTask_SuperResolution/Save_TrainedModel/_TrainedModels/_Process_Figures/_Update_Guides/**/*.md
